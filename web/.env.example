# Copy to .env.local. Never commit real keys. Local mode needs none of these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required on Vercel: long random invite code.
DEMO_INVITE_CODE=
# OpenAI-compatible chat/completions endpoint; choose a vision + JSON mode model.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Low reasoning effort is suitable for the tested gpt-6-luna configuration.
# Leave empty when using a provider/model without this parameter.
AI_REASONING_EFFORT=
# Supabase Free: at most 50. Set 100 only after upgrading bucket/global limits.
MAX_FILE_MB=50
MAX_TOTAL_MB=100
MAX_PAGES=80
DAILY_JOB_LIMIT=10
STORAGE_BUDGET_MB=700
SHARE_DAYS=7
PORT=8151
